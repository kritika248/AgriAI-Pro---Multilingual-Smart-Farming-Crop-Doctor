<!DOCTYPE html>
<html lang="hi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>AgriAI Pro - Multilingual Smart Farming</title>
    <style>
        @import url('https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;600;700&display=swap');

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: 'Poppins', sans-serif;
        }

        body {
            background: radial-gradient(circle at top right, #0a2e16, #030d06 70%);
            color: #f0fdf4;
            min-height: 100vh;
            padding: 15px;
            overflow-x: hidden;
        }

        /* Top Bar: Ticker + Language Selector */
        .top-bar {
            max-width: 550px;
            margin: 0 auto 15px;
            display: flex;
            justify-content: space-between;
            align-items: center;
            gap: 10px;
        }

        .lang-select {
            background: rgba(15, 45, 25, 0.9);
            color: #4ade80;
            border: 1px solid #4ade80;
            padding: 6px 12px;
            border-radius: 20px;
            font-size: 0.85rem;
            font-weight: 600;
            cursor: pointer;
            outline: none;
        }

        .ticker-wrap {
            flex: 1;
            background: rgba(34, 197, 94, 0.15);
            border: 1px solid rgba(34, 197, 94, 0.3);
            border-radius: 30px;
            padding: 6px 12px;
            overflow: hidden;
            white-space: nowrap;
        }
        .ticker {
            display: inline-block;
            animation: marquee 18s linear infinite;
            font-size: 0.82rem;
            color: #86efac;
        }
        @keyframes marquee {
            0% { transform: translateX(100%); }
            100% { transform: translateX(-100%); }
        }

